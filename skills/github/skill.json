{
  "env": ["GITHUB_TOKEN"],
  "requirements": ["mcp"],
  "preflight": {
    "url": "https://api.github.com/user",
    "bearer": "GITHUB_TOKEN"
  },
  "tools": {
    "github_repo_view": {"need_review": false},
    "github_tree": {"need_review": false},
    "github_file_read": {"need_review": false},
    "github_search_repos": {"need_review": false},
    "github_search_code": {"need_review": false},
    "github_issue_view": {"need_review": false},
    "github_pr_view": {"need_review": false},
    "github_issue_comments": {"need_review": false},
    "github_pr_reviews": {"need_review": false},
    "github_issue_list": {"need_review": false},
    "github_pr_list": {"need_review": false},
    "github_pr_diff": {"need_review": false},
    "github_pr_files": {"need_review": false},
    "github_release_list": {"need_review": false},
    "github_pr_create": {"need_review": true},
    "github_pr_review": {"need_review": true},
    "github_issue_comment": {"need_review": true}
  }
