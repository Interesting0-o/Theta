# ============================================================
# Theta 环境配置模板
# 使用方法: 复制本文件为 .env 并填入你自己的密钥
#   cp .env.example .env
# 切勿将包含真实密钥的 .env 提交到版本库！
# ============================================================

# -------------------- 聊天模型（必填） --------------------
# 默认走 DeepSeek 的 OpenAI 兼容接口，可换成任意兼容服务
CHAT_MODEL_API_KEY=sk-your-chat-model-api-key
CHAT_MODEL_URL=https://api.deepseek.com
CHAT_MODEL_NAME=deepseek-v4-flash

# -------------------- 思考模式（可选） --------------------
# 留空 = **不下发**这个参数，完全交给服务端默认（当前智谱 GLM-4.7 系列默认就开思考，
# 所以"关掉"才是需要显式配的那一边）。取值：
#   enabled  = 强制思考（答复更稳，但思考 token 也占额度）
#   disabled = 不思考（显著省 token、更快；实测同一问题 26 vs 1320 completion tokens）
# 只在你的模型/端点支持时才有效——参数名各家不同，映射单点在 app/agent/model.py::thinking_extra_body。
# ⚠️ 思考 token 计入 completion_tokens，因此也计入 max_tokens：若给模型设了偏小的 max_tokens，
#    会出现"思考把预算吃光、正文为空"（实测 max_tokens=300 时确实如此；本仓库不设 max_tokens，故安全）。
CHAT_THINKING=

# -------------------- Tavily 搜索（必填） --------------------
# 在 https://tavily.com 注册获取
TAVILY_API_KEY=tvly-your-tavily-api-key

# -------------------- GitHub 技能（可选） --------------------
# 供 skills/github 的技能工具使用：读远端仓库 / 目录树 / 文件 / issue / PR（**不克隆**，
# 全部只读免审），见 skills/github/SKILL.md。生成：https://github.com/settings/tokens
#   - classic token：只看公开仓库勾 public_repo；要读私有仓库需 repo
#   - 或用 fine-grained token，授 Contents 读权限
# 留空 = 该技能拒绝加载（get_skill 会给出明确回执），其余功能一概不受影响——
# 它是技能凭证，不参与核心启动（app/config.py 里有意带空默认）。
GITHUB_TOKEN=

# 主侧审批收件箱端口（可选，供 worker 审批回传）。**需要改的时候才取消注释**——
# 本键是整数，写成 `AGENT_INBOX_PORT=`（空值）会解析失败、整个程序起不来。
# AGENT_INBOX_PORT=25010

# -------------------- LangSmith 可观测性（可选） --------------------
# ⚠️ 这几个键由**第三方库直接读 `os.environ`**，而 `.env` 的值只会经 `get_settings()` 可见
# （pydantic-settings 读 .env 但不注入 os.environ）——所以写在这里**不生效**，
# 要在 shell 里 export（或在启动脚本里设）才起作用。
# 需要云端追踪时打开
LANGCHAIN_TRACING_V2=true

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2-your-langsmith-api-key
LANGSMITH_PROJECT=theta
